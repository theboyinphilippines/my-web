---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Books from '../components/Books.astro';
import Tutorials from '../components/Tutorials.astro';
import Notes from '../components/Notes.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="千里的站点">
	<Header />
	<main class="main">
		<Books />
		<Tutorials />
		<Notes limit={3} />
	</main>
	<Footer />
</BaseLayout>

<style>
	.main {
		display: flex;
		flex-direction: column;
		gap: 50px;
		padding: 80px;
	}
</style>
