---
import { getCollection, render } from 'astro:content';
import DetailLayout from '../layouts/DetailLayout.astro';

const entries = (await getCollection('application')).sort(
	(a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);

const rendered = await Promise.all(entries.map((entry) => render(entry)));
const headings = rendered.flatMap(({ headings }) => headings);
---

<DetailLayout title="应用 - 千里的站点" heading="应用" headings={headings}>
	{rendered.map(({ Content }) => <Content />)}
</DetailLayout>
