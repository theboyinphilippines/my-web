---
import bookStack from '../assets/book-stack.png';

const books = [
  {
    title: 'This is a book title',
    body: 'It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout. The point of using Lorem Ipsum is that....',
    href: '#',
  },
  {
    title: 'This is a book title',
    body: 'It is a long established fact that a reader will be the same thing I need to tell distracted by the readable content of a page when that was really funny looking at its layout. The point of using Lorem Ipsum is that....',
    href: '#',
  },
];
---

<section class="books">
  <h2 class="books__heading">书籍</h2>
  <div class="books__list">
    {
      books.map((book, index) => (
        <article class:list={['book', index % 2 === 1 && 'book--image-left']}>
          <div class="book__text">
            <h3 class="book__title">{book.title}</h3>
            <p class="book__body">{book.body}</p>
            <a class="book__link" href={book.href}>
              Read more
            </a>
          </div>
          <div class="book__panel">
            <img class="book__image" src={bookStack.src} alt="" />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .books {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .books__heading {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-h2);
    line-height: var(--line-height-h2);
  }

  .books__list {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .book {
    display: flex;
    min-height: 310px;
    border: 1px solid var(--brand-primary-2);
  }

  .book__text {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 37px;
    padding: 50px;
    color: var(--text-primary);
  }

  .book__title {
    margin: 0;
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-h2);
    line-height: var(--line-height-h2);
  }

  .book__body {
    margin: 0;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
  }

  .book__link {
    color: var(--brand-secondary-4);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body-bold);
    line-height: var(--line-height-body);
    text-decoration: none;
  }

  .book__panel {
    position: relative;
    flex: 0 0 40.6065%;
    overflow: hidden;
    background: linear-gradient(to bottom, #c9a96e, #f5e6c8);
  }

  .book__image {
    position: absolute;
    top: 11.36%;
    left: 50.06%;
    width: 50%;
    height: auto;
  }

  .book--image-left .book__panel {
    order: 1;
  }

  .book--image-left .book__text {
    order: 2;
    text-align: right;
  }
</style>
