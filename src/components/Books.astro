---
import BookCard from './BookCard.astro';
import { getBooks } from '../lib/books';

const books = (await getBooks()).slice(0, 2);
---

<section class="books">
  <h2 class="books__heading">书籍</h2>
  <div class="books__list">
    {books.map((book, index) => <BookCard {...book} imageLeft={index % 2 === 1} />)}
  </div>
</section>

<style>
  .books {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .books__heading {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-h2);
    line-height: var(--line-height-h2);
  }

  .books__list {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
</style>
