---
import TutorialCard from './TutorialCard.astro';

const tutorials = [
  { title: 'Tutorial Title', description: 'tutorial description', href: '#' },
  { title: 'Tutorial Title', description: 'tutorial description', href: '#' },
  { title: 'Tutorial Title', description: 'tutorial description', href: '#' },
];
---

<section class="tutorials">
  <h2 class="tutorials__heading">教程</h2>
  <div class="tutorials__list">
    {tutorials.map((tutorial) => <TutorialCard {...tutorial} />)}
  </div>
</section>

<style>
  .tutorials {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tutorials__heading {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-h2);
    line-height: var(--line-height-h2);
  }

  .tutorials__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 44.5px;
  }
</style>
