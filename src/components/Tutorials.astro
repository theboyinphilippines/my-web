---
import bookStack from '../assets/book-stack.png';

const tutorials = [
  { title: 'Tutorial Title', description: 'tutorial description', href: '#' },
  { title: 'Tutorial Title', description: 'tutorial description', href: '#' },
  { title: 'Tutorial Title', description: 'tutorial description', href: '#' },
];
---

<section class="tutorials">
  <h2 class="tutorials__heading">教程</h2>
  <div class="tutorials__list">
    {
      tutorials.map((tutorial) => (
        <a class="tutorial" href={tutorial.href}>
          <div class="tutorial__media">
            <img class="tutorial__image" src={bookStack.src} alt="" />
          </div>
          <div class="tutorial__text">
            <h3 class="tutorial__title">{tutorial.title}</h3>
            <p class="tutorial__description">{tutorial.description}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .tutorials {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tutorials__heading {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-h2);
    line-height: var(--line-height-h2);
  }

  .tutorials__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 44.5px;
  }

  .tutorial {
    display: flex;
    flex: 0 0 421px;
    flex-direction: column;
    gap: 30px;
    border: 1px solid var(--brand-primary-2);
    color: var(--text-primary);
    text-decoration: none;
  }

  .tutorial__media {
    height: 318px;
  }

  .tutorial__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tutorial__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 93px;
    padding: 0 10px;
  }

  .tutorial__title {
    margin: 0;
    font-size: var(--font-size-title);
    font-weight: var(--font-weight-title);
    line-height: var(--line-height-title);
  }

  .tutorial__description {
    margin: 0;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
  }
</style>
